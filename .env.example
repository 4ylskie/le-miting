APP_NAME="Le Miting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: set APP_ENV=production, APP_DEBUG=false, and APP_URL=https://your-domain.example.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=le_miting_dev
DB_USERNAME=le_miting_dev
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set SESSION_SECURE_COOKIE=true for HTTPS-only session cookies.

# Production: set both values to unique administrator credentials before seeding.
# ADMIN_INITIAL_EMAIL=admin@your-domain.example
# ADMIN_INITIAL_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI API (Rasa AI)
AI_DRIVER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-mock-key-for-development
OPENAI_ORGANIZATION=

# Academic/demo public information; opening hours live in config/restaurant.php.
RESTAURANT_NAME="Le Miting"
RESTAURANT_IS_DEMO=true
RESTAURANT_PHONE="+60 3-2148 8833"
RESTAURANT_PUBLIC_EMAIL="concierge@lemiting.my"
RESTAURANT_ADDRESS="Lot 18, Jalan Bukit Bintang, 55100 Kuala Lumpur, Wilayah Persekutuan Kuala Lumpur, Malaysia"
# Enquiry recipient (independent of the public display email).
RESTAURANT_EMAIL="contact@example.com"
GOOGLE_MAPS_EMBED_KEY=
GOOGLE_MAPS_EMBED_QUERY=
# Restrict the browser-visible key to Maps Embed API and allowed website/referrer
# domains. Use separate development/production keys; never commit actual keys.
GOOGLE_REVIEW_URL="https://www.google.com/maps?cid=YOUR_RESTAURANT_CID"

# FIUU Payment Gateway
PAYMENT_DRIVER=mock
FIUU_MERCHANT_ID=
FIUU_SECRET_KEY=
FIUU_RETURN_URL=http://localhost:8000/payment/return
FIUU_CALLBACK_URL=http://localhost:8000/payment/callback
